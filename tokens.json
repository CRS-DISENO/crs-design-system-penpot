{
  "$description": "Design tokens del sistema CRS. Fuente única: el plugin de Penpot. Lo leen el plugin, la página del proyecto y la landing del UI System.",
  "$extensions": {
    "crs.source": "penpot/v10/plugin.js",
    "crs.fontFamily": "Plus Jakarta Sans",
    "crs.fontStack": "Plus Jakarta Sans, system-ui, sans-serif",
    "crs.spacingScale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128
    ],
    "crs.generated": "buildTokens()",
    "crs.contentWidth": 1088,
    "crs.gridBase": 4
  },
  "grid": {
    "columns": {
      "$type": "number",
      "$value": {
        "mobile": 4,
        "tablet": 8,
        "desktop": 12
      }
    },
    "gutter": {
      "$type": "dimension",
      "$value": 16
    },
    "margin": {
      "$type": "dimension",
      "$value": {
        "mobile": 16,
        "tablet": 24,
        "desktop": 40
      }
    },
    "content": {
      "$type": "dimension",
      "$value": 1088
    },
    "base": {
      "$type": "dimension",
      "$value": 4
    }
  },
  "radius": {
    "r0": {
      "$type": "dimension",
      "$value": 0,
      "$description": "Por defecto en CRS: esquina recta"
    },
    "r1": {
      "$type": "dimension",
      "$value": 2
    },
    "r2": {
      "$type": "dimension",
      "$value": 4,
      "$description": "Arranque de la version del cliente"
    },
    "r3": {
      "$type": "dimension",
      "$value": 8
    },
    "r4": {
      "$type": "dimension",
      "$value": 12
    },
    "rfull": {
      "$type": "dimension",
      "$value": 999
    }
  },
  "shadow": {
    "e0": {
      "$type": "shadow",
      "$value": "none",
      "$description": "Plano"
    },
    "e1": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(11,46,71,.08)",
      "$description": "Apoyo: fichas y campos"
    },
    "e2": {
      "$type": "shadow",
      "$value": "0 4px 10px rgba(11,46,71,.10)",
      "$description": "Elevado: tarjetas y menus"
    },
    "e3": {
      "$type": "shadow",
      "$value": "0 10px 24px rgba(11,46,71,.14)",
      "$description": "Flotante: cabecera y dialogos"
    },
    "e4": {
      "$type": "shadow",
      "$value": "0 20px 44px rgba(11,46,71,.18)",
      "$description": "Destacado: cierre y cinta"
    }
  },
  "color": {
    "blue-200": {
      "$type": "color",
      "$value": "#A8CCE8",
      "$description": "Borde de componente inactivo"
    },
    "blue-400": {
      "$type": "color",
      "$value": "#4E8FBF",
      "$description": "Enlace sobre fondo claro"
    },
    "blue-500": {
      "$type": "color",
      "$value": "#2E7BB0",
      "$description": "Hover de superficie azul"
    },
    "blue-600": {
      "$type": "color",
      "$value": "#1C6CA9",
      "$description": "Azul de marca, paso 600 de la rampa"
    },
    "blue-800": {
      "$type": "color",
      "$value": "#08202F",
      "$description": "Fondo mas profundo que blue-900"
    },
    "blue": {
      "$type": "color",
      "$value": "#1C6CA9",
      "$description": "Azul de marca: énfasis, enlaces, botones y numeración"
    },
    "black": {
      "$type": "color",
      "$value": "#1D1D1C",
      "$description": "Negro de marca para texto"
    },
    "blue-50": {
      "$type": "color",
      "$value": "#EAF2F8",
      "$description": "Fondo de estado y de alerta informativa"
    },
    "blue-100": {
      "$type": "color",
      "$value": "#CFE2F0",
      "$description": "Bordes suaves y fin del degradado"
    },
    "blue-300": {
      "$type": "color",
      "$value": "#7FB0D4",
      "$description": "Vidrio iluminado y acento interactivo en oscuro"
    },
    "blue-700": {
      "$type": "color",
      "$value": "#124C76",
      "$description": "Hover y texto sobre fondo claro"
    },
    "blue-900": {
      "$type": "color",
      "$value": "#0B2E47",
      "$description": "Fondos oscuros profundos"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Texto, objeto o superficie"
    },
    "bg-base": {
      "$type": "color",
      "$value": "#F4F6F8",
      "$description": "Fondo base claro"
    },
    "dark": {
      "$type": "color",
      "$value": "#0E1116",
      "$description": "Fondo base oscuro, nunca negro puro"
    },
    "dark-panel": {
      "$type": "color",
      "$value": "#131A24",
      "$description": "Panel oscuro"
    },
    "text-primary": {
      "$type": "color",
      "$value": "#1D1D1C",
      "$description": "Texto principal"
    },
    "text-secondary": {
      "$type": "color",
      "$value": "#5A6068",
      "$description": "Texto secundario"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#8B939C",
      "$description": "Texto terciario"
    },
    "text-light": {
      "$type": "color",
      "$value": "#F2F4F7",
      "$description": "Texto sobre fondo oscuro"
    },
    "text-muted-dark": {
      "$type": "color",
      "$value": "#6E7781",
      "$description": "Texto terciario en tema oscuro"
    },
    "accent-orange": {
      "$type": "color",
      "$value": "#F0A868",
      "$description": "Solo advertencia o precaución"
    },
    "accent-success": {
      "$type": "color",
      "$value": "#3FA97B",
      "$description": "Solo éxito o mensaje positivo"
    },
    "accent-danger": {
      "$type": "color",
      "$value": "#D9534F",
      "$description": "Solo error o señal negativa"
    }
  },
  "typography": {
    "display-hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "800",
        "fontSize": 96,
        "lineHeight": "1.02",
        "letterSpacing": "-0.03em"
      },
      "$description": "Titular de portada"
    },
    "display-h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "800",
        "fontSize": 60,
        "lineHeight": "1.05",
        "letterSpacing": "-0.02em"
      },
      "$description": "Titulo de pagina"
    },
    "display-h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "700",
        "fontSize": 40,
        "lineHeight": "1.12",
        "letterSpacing": "-0.01em"
      },
      "$description": "Titulo de seccion"
    },
    "display-h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "700",
        "fontSize": 24,
        "lineHeight": "1.2",
        "letterSpacing": "0"
      },
      "$description": "Subtitulo y nombre de producto"
    },
    "body-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "400",
        "fontSize": 18,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      "$description": "Texto destacado"
    },
    "body-base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "400",
        "fontSize": 16,
        "lineHeight": "1.6",
        "letterSpacing": "0"
      },
      "$description": "Texto base"
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "400",
        "fontSize": 14,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      "$description": "Texto secundario"
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "700",
        "fontSize": 12,
        "lineHeight": "1.3",
        "letterSpacing": "0.14em"
      },
      "$description": "Etiquetas con tracking"
    }
  },
  "space": {
    "s1": {
      "$type": "dimension",
      "$value": 4
    },
    "s2": {
      "$type": "dimension",
      "$value": 8
    },
    "s3": {
      "$type": "dimension",
      "$value": 12
    },
    "s4": {
      "$type": "dimension",
      "$value": 16
    },
    "s5": {
      "$type": "dimension",
      "$value": 24
    },
    "s6": {
      "$type": "dimension",
      "$value": 32
    },
    "s7": {
      "$type": "dimension",
      "$value": 48
    },
    "s8": {
      "$type": "dimension",
      "$value": 64
    },
    "s9": {
      "$type": "dimension",
      "$value": 96
    },
    "s10": {
      "$type": "dimension",
      "$value": 128
    }
  }
}
