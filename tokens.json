{
  "$description": "Design tokens del sistema CRS. Fuente única: el plugin de Penpot. Lo leen el plugin, la página del proyecto y la landing del UI System.",
  "$extensions": {
    "crs.source": "penpot/v10/plugin.js",
    "crs.fontFamily": "Plus Jakarta Sans",
    "crs.fontStack": "Plus Jakarta Sans, system-ui, sans-serif",
    "crs.spacingScale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128
    ],
    "crs.generated": "buildTokens()"
  },
  "color": {
    "blue": {
      "$type": "color",
      "$value": "#1A6CA7",
      "$description": "Azul de marca: énfasis, enlaces, botones y numeración"
    },
    "black": {
      "$type": "color",
      "$value": "#1D1D1C",
      "$description": "Negro de marca para texto"
    },
    "blue-50": {
      "$type": "color",
      "$value": "#EAF2F8",
      "$description": "Fondo de estado y de alerta informativa"
    },
    "blue-100": {
      "$type": "color",
      "$value": "#CFE2F0",
      "$description": "Bordes suaves y fin del degradado"
    },
    "blue-300": {
      "$type": "color",
      "$value": "#7FB0D4",
      "$description": "Vidrio iluminado y acento interactivo en oscuro"
    },
    "blue-700": {
      "$type": "color",
      "$value": "#124C76",
      "$description": "Hover y texto sobre fondo claro"
    },
    "blue-900": {
      "$type": "color",
      "$value": "#0B2E47",
      "$description": "Fondos oscuros profundos"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Texto, objeto o superficie"
    },
    "bg-base": {
      "$type": "color",
      "$value": "#F4F6F8",
      "$description": "Fondo base claro"
    },
    "dark": {
      "$type": "color",
      "$value": "#0E1116",
      "$description": "Fondo base oscuro, nunca negro puro"
    },
    "dark-panel": {
      "$type": "color",
      "$value": "#131A24",
      "$description": "Panel oscuro"
    },
    "text-primary": {
      "$type": "color",
      "$value": "#1D1D1C",
      "$description": "Texto principal"
    },
    "text-secondary": {
      "$type": "color",
      "$value": "#5A6068",
      "$description": "Texto secundario"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#8B939C",
      "$description": "Texto terciario"
    },
    "text-light": {
      "$type": "color",
      "$value": "#F2F4F7",
      "$description": "Texto sobre fondo oscuro"
    },
    "text-muted-dark": {
      "$type": "color",
      "$value": "#6E7781",
      "$description": "Texto terciario en tema oscuro"
    },
    "accent-orange": {
      "$type": "color",
      "$value": "#F0A868",
      "$description": "Solo advertencia o precaución"
    },
    "accent-success": {
      "$type": "color",
      "$value": "#3FA97B",
      "$description": "Solo éxito o mensaje positivo"
    },
    "accent-danger": {
      "$type": "color",
      "$value": "#D9534F",
      "$description": "Solo error o señal negativa"
    }
  },
  "typography": {
    "display-hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "800",
        "fontSize": 96
      },
      "$description": "Titular de portada"
    },
    "display-h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "800",
        "fontSize": 60
      },
      "$description": "Título de página"
    },
    "display-h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "700",
        "fontSize": 40
      },
      "$description": "Título de sección"
    },
    "display-h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "700",
        "fontSize": 24
      },
      "$description": "Subtítulo y nombre de producto"
    },
    "body-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "400",
        "fontSize": 18
      },
      "$description": "Texto destacado"
    },
    "body-base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "400",
        "fontSize": 16
      },
      "$description": "Texto base"
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "400",
        "fontSize": 14
      },
      "$description": "Texto secundario"
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "700",
        "fontSize": 12
      },
      "$description": "Etiquetas en mayúsculas con tracking"
    }
  },
  "space": {
    "s1": {
      "$type": "dimension",
      "$value": 4
    },
    "s2": {
      "$type": "dimension",
      "$value": 8
    },
    "s3": {
      "$type": "dimension",
      "$value": 12
    },
    "s4": {
      "$type": "dimension",
      "$value": 16
    },
    "s5": {
      "$type": "dimension",
      "$value": 24
    },
    "s6": {
      "$type": "dimension",
      "$value": 32
    },
    "s7": {
      "$type": "dimension",
      "$value": 48
    },
    "s8": {
      "$type": "dimension",
      "$value": 64
    },
    "s9": {
      "$type": "dimension",
      "$value": 96
    },
    "s10": {
      "$type": "dimension",
      "$value": 128
    }
  }
}
